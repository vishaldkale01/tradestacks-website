---
import items from '../data/linkedin-posts.json';

type LinkedInEntry = {
  url: string;
  type: 'post' | 'article';
  title?: string;
  summary?: string;
  date?: string;
  image?: string;
  imageAlt?: string;
};

const profileUrl = 'https://www.linkedin.com/in/algodev01/';

const isSupportedPostUrl = (url: string) => {
  try {
    const parsed = new URL(url);
    return parsed.protocol === 'https:' &&
      ['linkedin.com', 'www.linkedin.com'].includes(parsed.hostname) &&
      (/^\/posts\//.test(parsed.pathname) || /^\/pulse\//.test(parsed.pathname) ||
       /^\/feed\/update\//.test(parsed.pathname));
  } catch {
    return false;
  }
};
const validDate = (date: string | undefined): date is string =>
  typeof date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(date) && !Number.isNaN(Date.parse(date));

const hasContent = (item: LinkedInEntry): boolean =>
  typeof item.title === 'string' && item.title.trim().length >= 10 &&
  typeof item.summary === 'string' && item.summary.trim().length >= 20;

const allowedImage = (item: LinkedInEntry) =>
  typeof item.image === 'string' &&
  /^\/images\/blog\/[a-z0-9/_-]+\.(?:avif|webp|png|jpe?g)$/.test(item.image) &&
  typeof item.imageAlt === 'string' && item.imageAlt.length >= 8;

const posts: LinkedInEntry[] = (items as LinkedInEntry[])
  .filter(item => ['post', 'article'].includes(item.type) &&
    typeof item.url === 'string' && isSupportedPostUrl(item.url))
  .sort((a,b) => (b.date || '').localeCompare(a.date || ''));

const dateLabel = (date: string) => new Date(date + 'T00:00:00Z')
  .toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<section class="section linkedin-section" id="from-linkedin">
  <div class="container">
    <div class="linkedin-head">
      <div>
        <span class="section-overline">BEYOND THE JOURNAL</span>
        <h2>From LinkedIn.<br />Into the conversation.</h2>
        <p>Selected social posts and articles shared with the TradeStack Journal. Each card links to its original LinkedIn page. This is a curated collection, not a live feed.</p>
      </div>
      <a class="linkedin-profile-btn" href={profileUrl} target="_blank" rel="noopener noreferrer">View LinkedIn profile ↗</a>
    </div>
    {posts.length > 0 ? (
      <div class="linkedin-feed">
        {posts.map(post => (
          <article class="linkedin-card">
            {allowedImage(post) && (
              <a class="linkedin-card-media" href={post.url} target="_blank" rel="noopener noreferrer" aria-label={'Open the LinkedIn ' + post.type}>
                <img src={post.image} alt={post.imageAlt} loading="lazy" decoding="async" width="1000" height="625" />
              </a>
            )}
            <div class="linkedin-card-body">
              <div class="linkedin-card-meta">
                <span>{post.type === 'article' ? 'LINKEDIN ARTICLE' : 'LINKEDIN POST'}</span>
                {validDate(post.date) ? (
                  <time datetime={post.date}>{dateLabel(post.date)}</time>
                ) : (
                  <span>DATE NOT VERIFIED</span>
                )}
              </div>
              <h3><a href={post.url} target="_blank" rel="noopener noreferrer">{hasContent(post) ? post.title : 'LinkedIn post shared for review'}</a></h3>
              <p>{hasContent(post) ? post.summary : 'Open the original post on LinkedIn. Its text, publication date and image have not yet been independently checked for this website.'}</p>
              <a class="linkedin-card-link" href={post.url} target="_blank" rel="noopener noreferrer">View original on LinkedIn ↗</a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="linkedin-intro">
        <div>
          <strong>Follow our engineering updates.</strong>
          <p>LinkedIn posts will appear here after their source links are submitted. Follow the profile directly for updates.</p>
        </div>
        <a class="button button-outline" href={profileUrl} target="_blank" rel="noopener noreferrer">Explore LinkedIn ↗</a>
      </div>
    )}
  </div>
</section>
